# CallAgent sozlamalari. start.bat birinchi ishga tushishda bu fayldan .env yaratadi
# va maxfiy kalitlarni (parollar, tokenlar) o'zi to'ldiradi.
# Siz faqat API kalitlarini va (telefon kerak bo'lsa) Twilio ma'lumotlarini yozasiz.

# ---------- Majburiy: AI kalitlari ----------
# Gemini (agentning "miyasi"): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Yandex SpeechKit (o'zbekcha nutqni tanish va ovoz): https://console.yandex.cloud
# Servis akkaunt -> API kalit (rollar: ai.speechkit-stt.user, ai.speechkit-tts.user)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# yandex | google
STT_PROVIDER=yandex

# ---------- Telefon (agent o'zi qo'ng'iroq qilishi uchun) ----------
# https://console.twilio.com -> Account SID, Auth Token va sotib olingan raqam (+1...)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Kirish ----------
ADMIN_EMAIL=admin@callagent.uz
ADMIN_PASSWORD=

# ---------- Texnik (odatda o'zgartirmang) ----------
WEB_PORT=8080
# auto = Cloudflare tunnel manzili avtomatik. O'z domeningiz bo'lsa: https://domen.uz
PUBLIC_URL=auto
DB_PASSWORD=
DB_NAME=callagent
INTERNAL_TOKEN=
JWT_SECRET=

# Ixtiyoriy: STT_PROVIDER=google bo'lsa (Google Cloud Speech, Chirp)
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp.json
# GOOGLE_STT_LOCATION=us-central1
# GOOGLE_STT_MODEL=chirp_2
