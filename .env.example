# ---------- Umumiy ----------
# Dashboard ochiladigan port
WEB_PORT=8080
# Saytingizning ommaviy manzili (HTTPS). Lokal sinovda: http://localhost:8080
PUBLIC_API_URL=https://callagent.example.uz
# Brauzer va Twilio ulanadigan WebSocket manzili (o'sha domen, wss://)
AGENT_PUBLIC_WS_URL=wss://callagent.example.uz

# Server va agent ishchisi o'rtasidagi maxfiy kalit (uzun tasodifiy satr)
INTERNAL_TOKEN=almashtiring-uzun-tasodifiy-satr
JWT_SECRET=almashtiring-boshqa-uzun-satr

# Birinchi ishga tushishda yaratiladigan admin
ADMIN_EMAIL=admin@example.uz
ADMIN_PASSWORD=almashtiring

# ---------- MySQL ----------
DB_PASSWORD=almashtiring
DB_NAME=callagent

# ---------- Yandex SpeechKit (STT + TTS) ----------
# Yandex Cloud -> servis akkaunt -> API kalit (rol: ai.speechkit-stt.user, ai.speechkit-tts.user)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# yandex | google
STT_PROVIDER=yandex

# ---------- Google Gemini (LLM) ----------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ixtiyoriy: STT_PROVIDER=google bo'lsa (Google Cloud Speech, Chirp)
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp.json
# GOOGLE_STT_LOCATION=us-central1
# GOOGLE_STT_MODEL=chirp_2

# ---------- Telefoniya (Twilio) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
